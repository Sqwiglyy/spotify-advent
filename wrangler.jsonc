{
  "name": "spotify-advent",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spotify-advent",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "PAGES_ORIGIN": "https://sqwiglyy.github.io"
  }
}
