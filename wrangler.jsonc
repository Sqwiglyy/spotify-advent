{
  "name": "spotify-advent",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spotify-advent",
      "database_id": "e496b28f-674f-44e4-a0c8-8ea2f23fd480"
    }
  ],
  "vars": {
    "PAGES_ORIGIN": "https://sqwiglyy.github.io",
    "PREVIEW_MODE": "true"
  },
  "triggers": {
    "crons": [
      "0 */2 * * *"
    ]
  }
}
